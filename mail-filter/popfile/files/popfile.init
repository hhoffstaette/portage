#!/sbin/openrc-run

APP=popfile.pl
APP_DIR=/usr/share/popfile
PID_FILE=/run/popfile.pid

depend() {
	need net
	use dns
	before fetchmail
}

start() {
	ebegin "Starting POPFile"
	start-stop-daemon --start -b -w 2000 -p ${PID_FILE} -d ${APP_DIR} -x ${APP_DIR}/${APP}
	eend $?
}

stop() {
	ebegin "Stopping POPFile"
	start-stop-daemon --stop -p ${PID_FILE}
	eend $?
}
